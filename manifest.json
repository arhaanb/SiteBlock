{
  "manifest_version": 3,
  "name": "SiteBlock",
  "description": "A simple site blocker.",
  "version": "1.0",
  "icons": { "128": "./assets/icon.png" },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "tabs", "webNavigation"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "./assets/icon.png",
    "default_popup": "popup.html",
    "default_title": "BlockSite"
  }
}
